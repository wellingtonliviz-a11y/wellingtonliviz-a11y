# Copie para .env e preencha
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio
APP_URL=http://localhost:5000
PRODUCT_NAME=Agência Liviz
# Banco: sem DATABASE_URL usa o arquivo agencia.db (SQLite)
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Conta criada no primeiro start (depois troque a senha em "Conta")
ADMIN_EMAILS=voce@exemplo.com
ADMIN_INITIAL_PASSWORD=troque-esta-senha
# Tamanho máximo de cada arquivo enviado (MB)
MAX_FILE_MB=15
TIMEZONE=America/Sao_Paulo
