# --- WhatsApp Cloud API (developers.facebook.com > seu app > WhatsApp) ---
WHATSAPP_TOKEN=cole-aqui-o-token-de-acesso
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Você inventa este valor e cola o mesmo no painel da Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=meu-token-secreto
# App secret (Configurações do app > Básico). Valida que o webhook veio da Meta.
WHATSAPP_APP_SECRET=

# --- Loja ---
STORE_NAME=Doces da Maria
PIX_KEY=doces@email.com
BUSINESS_HOURS=Seg a Sáb, 9h às 19h
# Taxa de entrega em centavos (500 = R$ 5,00). 0 = sem taxa
DELIVERY_FEE_CENTS=500

# Números dos vendedores (DDI + DDD + número), separados por vírgula
ADMIN_PHONES=5511999998888

DATABASE_PATH=vendas.db
