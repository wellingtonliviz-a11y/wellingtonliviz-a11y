# ===== Obrigatórias =====
# Chave secreta longa e aleatória (no Render use "Generate"). Nunca compartilhe.
SECRET_KEY=troque-por-uma-chave-bem-longa-e-aleatoria
# Endereço público do sistema, sem barra no final
APP_URL=https://precifica-manicure.onrender.com
# Banco PostgreSQL (Render/Railway/Neon preenchem). Sem isso usa SQLite local.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# ===== E-mail (para mandar login e senha) =====
# Ex. Brevo: smtp-relay.brevo.com / porta 587. Resend: smtp.resend.com / 465
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu-login-smtp
SMTP_PASSWORD=sua-chave-smtp
MAIL_FROM=Precifica Fácil Manicure <acesso@seudominio.com.br>
SUPPORT_EMAIL=suporte@seudominio.com.br

# ===== Hotmart =====
# Ferramentas > Webhook (API e notificações) > copie o "Hottok"
HOTMART_HOTTOK=
# IDs dos produtos que liberam acesso (vazio = qualquer produto da conta)
HOTMART_PRODUCT_IDS=

# ===== Kiwify =====
# Apps > Webhooks > crie o webhook e copie o "Token"
KIWIFY_TOKEN=
KIWIFY_PRODUCT_IDS=

# ===== Asaas (venda direta) =====
# Integrações > Webhooks: o "Token de autenticação" que você inventar ao criar o webhook
ASAAS_WEBHOOK_TOKEN=
# Integrações > Chave de API (começa com $aact_). Usada só para ler nome e e-mail do cliente.
ASAAS_API_KEY=
# Produção. Para testar no sandbox use https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3
# OBRIGATÓRIO: código dos links de pagamento do Precifica Fácil Manicure (o final de asaas.com/c/CODIGO), separados por vírgula
ASAAS_PAYMENT_LINK_IDS=
# 1 = bloqueia quando a cobrança vence sem pagamento (libera de novo ao pagar). 0 = não bloqueia
ASAAS_BLOCK_OVERDUE=1

# ===== Empresa (Termos de uso e Política de privacidade) =====
COMPANY_NAME=Liviz Software
COMPANY_DOC=
COMPANY_EMAIL=contato@livizsoftware.com.br

# ===== Seu acesso de dono =====
ADMIN_EMAILS=wellington@seudominio.com.br
# Senha usada só para criar sua conta no primeiro start. Troque depois em "Minha conta".
ADMIN_INITIAL_PASSWORD=

# ===== Vendas =====
PRODUCT_NAME=Precifica Fácil Manicure
# Preço mostrado na página de vendas
PLAN_PRICE=49,90
# Fuso horário da agenda
TIMEZONE=America/Sao_Paulo
# Link do checkout (aparece no botão da demonstração)
CHECKOUT_URL=https://pay.kiwify.com.br/seu-produto
# 0 desliga a página /demo
DEMO_ENABLED=1
